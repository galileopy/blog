[38;5;231m workflow;                                          \r\u001b[7C\u001b[1B\u001b[38;5;77m9\u001b[13G\u001b[38;5;231m  \u001b[16G                    \u001b[37G      \u001b[44G         \r\u001b[6C\u001b[1B\u001b[38;5;77m20\u001b[13G\u001b[38;5;81mconst\u001b[19G\u001b[38;5;231mindex\u001b[25G=\u001b[27Gworkflow.steps.\u001b[38;5;148mfindIndex\u001b[38;5;231m((\u001b[38;5;208ms\u001b[38;5;231m)\u001b[56G=>\u001b[59Gs.status\u001b[68G===\u001b[72G\u001b[38;5;186m\"pending\"\u001b[38;5;231m);\r\u001b[7C\u001b[1B\u001b[38;5;77m1\u001b[13G\u001b[38;5;197mif\u001b[38;5;231m (index ==\u001b[27G-\u001b[38;5;141m1\u001b[38;5;231m) \u001b[38;5;197mreturn\u001b[38;5;231m { .\u001b[42G.workflow, \u001b[38;5;148mcompleted\u001b[38;5;231m: \u001b[38;5;141mtrue\u001b[38;5;231m };\u001b[72G           \r\u001b[7C\u001b[1B\u001b[38;5;77m2\u001b[13G\u001b[38;5;231m  \u001b[16G      \u001b[23G   \u001b[27G   \u001b[31G      \u001b[38G \u001b[40G            \u001b[53G          \u001b[64G    \u001b[69G  \r\u001b[7C\u001b[1B\u001b[38;5;77m3\u001b[13G\u001b[38;5;81mconst\u001b[19G\u001b[38;5;231msteps\u001b[25G=\u001b[27Gworkflow.steps.\u001b[38;5;148mmap\u001b[38;5;231m((\u001b[38;5;208mstep, i\u001b[38;5;231m)\u001b[56G=>\r\u001b[7C\u001b[1B\u001b[38;5;77m4\u001b[13G\u001b[38;5;231m  i === index\u001b[27G? { ...step, \u001b[38;5;148mstatus\u001b[38;5;231m: \u001b[38;5;186m\"done\"\u001b[38;5;231m } :\u001b[59Gstep,\r\u001b[7C\u001b[1B\u001b[38;5;77m5\u001b[13G\u001b[38;5;231m); \u001b[17G   \u001b[21G     \u001b[27G \u001b[29G \u001b[31G        \u001b[40G       \u001b[48G      \u001b[55G \u001b[57G \u001b[59G     \r\u001b[7C\u001b[1B\u001b[38;5;77m6\u001b[13G\u001b[38;5;81mconst\u001b[19G\u001b[38;5;231mnext\u001b[24G=\u001b[26G{\u001b[28G...workflow,\u001b[41Gsteps\u001b[47G};\r\u001b[7C\u001b[1B\u001b[38;5;77m7\u001b[13G\u001b[38;5;197mif\u001b[38;5;231m (steps.\u001b[38;5;148mevery\u001b[38;5;231m((\u001b[38;5;208ms\u001b[38;5;231m) => s.status !== \u001b[38;5;186m\"pending\"\u001b[38;5;231m))\u001b[61Gnext.completed\u001b[76G=\u001b[78G\u001b[38;5;141mtrue\u001b[38;5;231m;\r\u001b[7C\u001b[1B\u001b[38;5;77m8\u001b[13G\u001b[38;5;197mreturn\u001b[38;5;231m next;       \u001b[33G  \u001b[36G        \u001b[45G   \u001b[49G           \u001b[61G              \u001b[76G \u001b[78G     \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 29 \u001b[22m }\u001b[39m\u001b[K\r\u001b[6C\u001b[1B\u001b[38;5;231m\u001b[2m30\u001b[11G\u001b[22m\u001b[39m\u001b[K\r\u001b[7C\u001b[1B\u001b[38;5;231m\u001b[2m1\u001b[11G\u001b[22m\u001b[38;5;197mexport\u001b[38;5;231m \u001b[38;5;81mfunction\u001b[38;5;231m \u001b[38;5;148mcurrentStep\u001b[38;5;231m(\u001b[38;5;208mworkflow\u001b[38;5;231m) {\r\u001b[5C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;246m●\u001b[3G\u001b[39mRunning\u001b[11G\u001b[1m1\u001b[13G\u001b[22mshell\u001b[19Gcommand…\r\u001b[1B\u001b[38;5;246m  ⎿  $ npm test 2>&1 | tail -20\r\u001b[33C\u001b[2B)\u001b[39m\u001b[K\u001b[43;1H\u001b[38;3H\u001b[?25h"]
