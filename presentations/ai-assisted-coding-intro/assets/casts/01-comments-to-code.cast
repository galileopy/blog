[50.092014, "o", "\u001b[?25l\u001b[H\r\u001b[13B\u001b[38;5;114m●\r\u001b[1B\u001b[38;5;246m  ⎿  \u001b[39mAdded\u001b[12G\u001b[1m11\u001b[15G\u001b[22mlines,\u001b[22Gremoved\u001b[30G\u001b[1m1\u001b[32G\u001b[22mline\r\u001b[5C\u001b[1B\u001b[38;5;231m\u001b[2m 15 \u001b[22m \u001b[38;5;242m// - never mutate the input; return a new workflow object\r\u001b[5C\u001b[1B\u001b[38;5;231m\u001b[2m 16 \u001b[22m \u001b[38;5;242m// - calling advance on a completed workflow returns it unchanged\r\u001b[5C\u001b[1B\u001b[38;5;231m\u001b[2m 17 \u001b[22m \u001b[38;5;197mexport\u001b[38;5;231m \u001b[38;5;81mfunction\u001b[38;5;231m \u001b[38;5;148madvance\u001b[38;5;231m(\u001b[38;5;208mworkflow\u001b[38;5;231m) {\r\u001b[5C\u001b[1B\u001b[38;5;167m\u001b[48;5;52m 18 -\u001b[38;5;231m  throw new Error(\"not implemented\"); // ← demo 1 fills this in                     \r\u001b[5C\u001b[1B\u001b[38;5;77m\u001b[48;5;22m 18 +\u001b[38;5;231m  \u001b[38;5;197mif\u001b[38;5;231m (workflow.completed) \u001b[38;5;197mreturn\u001b[38;5;231m workflow;                                          \r\u001b[5C\u001b[1B\u001b[38;5;77m 19 +\u001b[38;5;231m                                                                                    \r\u001b[5C\u001b[1B\u001b[38;5;77m 20 +\u001b[38;5;231m  \u001b[38;5;81mconst\u001b[38;5;231m index = workflow.steps.\u001b[38;5;148mfindIndex\u001b[38;5;231m((\u001b[38;5;208ms\u001b[38;5;231m) => s.status === \u001b[38;5;186m\"pending\"\u001b[38;5;231m);            \r\u001b[5C\u001b[1B\u001b[38;5;77m 21 +\u001b[38;5;231m  \u001b[38;5;197mif\u001b[38;5;231m (index === -\u001b[38;5;141m1\u001b[38;5;231m) \u001b[38;5;197mreturn\u001b[38;5;231m { ...workflow, \u001b[38;5;148mcompleted\u001b[38;5;231m: \u001b[38;5;141mtrue\u001b[38;5;231m };                        \r\u001b[5C\u001b[1B\u001b[38;5;77m 22 +\u001b[38;5;231m                                                                                    \r\u001b[5C\u001b[1B\u001b[38;5;77m 23 +\u001b[38;5;231m  \u001b[38;5;81mconst\u001b[38;5;231m steps = workflow.steps.\u001b[38;5;148mmap\u001b[38;5;231m((\u001b[38;5;208mstep, i\u001b[38;5;231m) =>                                     \r\u001b[5C\u001b[1B\u001b[38;5;77m 24 +\u001b[38;5;231m    i === index ? { ...step, \u001b[38;5;148mstatus\u001b[38;5;231m: \u001b[38;5;186m\"done\"\u001b[38;5;231m } : step,                               \r\u001b[5C\u001b[1B\u001b[38;5;77m 25 +\u001b[38;5;231m  );                                                                                \r\u001b[5C\u001b[1B\u001b[38;5;77m 26 +\u001b[38;5;231m  \u001b[38;5;81mconst\u001b[38;5;231m next = { ...workflow, steps };                                              \r\u001b[5C\u001b[1B\u001b[38;5;77m 27 +\u001b[38;5;231m  \u001b[38;5;197mif\u001b[38;5;231m (steps.\u001b[38;5;148mevery\u001b[38;5;231m((\u001b[38;5;208ms\u001b[38;5;231m) => s.status !== \u001b[38;5;186m\"pending\"\u001b[38;5;231m)) next.completed = \u001b[38;5;141mtrue\u001b[38;5;231m;            \r\u001b[5C\u001b[1B\u001b[38;5;77m 28 +\u001b[38;5;231m  \u001b[38;5;197mreturn\u001b[38;5;231m next;                                                                      \r\u001b[5C\u001b[1B\u001b[49m\u001b[2m 29 \u001b[22m }\r\u001b[5C\u001b[1B\u001b[2m 30 \u001b[22m \r\u001b[5C\u001b[1B\u001b[2m 31 \u001b[22m \u001b[38;5;197mexport\u001b[38;5;231m \u001b[38;5;81mfunction\u001b[38;5;231m \u001b[38;5;148mcurrentStep\u001b[38;5;231m(\u001b[38;5;208mworkflow\u001b[38;5;231m) {\r\u001b[2B\u001b[38;5;174m·\u001b[3G\u001b[38;5;180mGenerating…\u001b[25G\u001b[38;5;246m62\u001b[39m\u001b[43;1H\u001b[38;3H\u001b[?25h"]
