[102.266308, "o", "\u001b[1mdiff --git a/presentations/ai-assisted-coding-intro/demos/01-comments-to-code/wfm/src/workflow.js b/presentations/ai-assisted-coding-intro/demos/01-comments-to-code/wfm/src/workflow.js\u001b[m\r\n\u001b[1mindex 8c12d1b..997f847 100644\u001b[m\r\n\u001b[1m--- a/presentations/ai-assisted-coding-intro/demos/01-comments-to-code/wfm/src/workflow.js\u001b[m\r\n\u001b[1m+++ b/presentations/ai-assisted-coding-intro/demos/01-comments-to-code/wfm/src/workflow.js\u001b[m\r\n\u001b[36m@@ -15,7 +15,17 @@\u001b[m \u001b[mexport function createWorkflow(name, steps) {\u001b[m\r\n // - never mutate the input; return a new workflow object\u001b[m\r\n // - calling advance on a completed workflow returns it unchanged\u001b[m\r\n export function advance(workflow) {\u001b[m\r\n\u001b[31m-  throw new Error(\"not implemented\"); // ← demo 1 fills this in\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  if (workflow.completed) return workflow;\u001b[m\r\n\u001b[32m+\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  const index = workflow.steps.findIndex((s) => s.status === \"pending\");\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  if (index === -1) return { ...workflow, completed: true };\u001b[m\r\n\u001b[32m+\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  const steps = workflow.steps.map((step, i) =>\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    i === index ? { ...step, status: \"done\" } : step,\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  );\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  const next = { ...workflow, steps };\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  if (steps.every((s) => s.status !== \"pending\")) next.completed = true;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  return next;\u001b[m\r\n }\u001b[m\r\n"]
