[42.113097, "o", "\u001b[?25l\u001b[H\u001b[K\r\u001b[1B\u001b[38;5;114m●\u001b[39m \u001b[1mSkill\u001b[22m(craft:collect)\u001b[K\r\u001b[1B\u001b[38;5;246m  ⎿  \u001b[39mSuccessfully loaded skill\u001b[K\r\u001b[2B\u001b[38;5;231m●\u001b[3G\u001b[39mI'll\u001b[8Gread\u001b[13Gthe\u001b[17Gticket\u001b[24Gand\u001b[28Gthe\u001b[32Gcode\u001b[37Gin\u001b[40Gparallel.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;246mRead \u001b[1m5\u001b[22m files, called plugin:linear:linear \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;231m●\u001b[3G\u001b[39mI've\u001b[8Gread\u001b[13Gthe\u001b[17Gticket\u001b[24Gand\u001b[28Gthe\u001b[32Gcode.\u001b[38GThe\u001b[42GAPI\u001b[46Galready\u001b[54Gtakes\u001b[60G\u001b[38;5;153mPOST /api/v1/runs {name, steps}\u001b[39m;\u001b[93G\u001b[38;5;153mMain.elm\r\u001b[1B\u001b[39m \u001b[3Ghas no form and no router.\u001b[30GThree\u001b[36Gthings\u001b[43Gwould\u001b[49Gchange\u001b[56Gwhat\u001b[61Ggets\u001b[66Gbuilt:\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;246m────────────────────────────────────────────────────────────────────────────────────────────────────\r\u001b[1B← \u001b[48;5;153m\u001b[38;5;16m ☐ Step input \u001b[39m\u001b[49m ☐ Placemen\u001b[29G  ☐ Fe\u001b[36Gdback  ✔ Submit\u001b[53G→\r\u001b[2B\u001b[38;5;231m\u001b[1mHow does the user enter the list of step titles in the inline form?\r\u001b[2B\u001b[22m\u001b[38;5;153m❯\u001b[38;5;246m 1.\u001b[38;5;153m\u001b[1m One textarea, one step \u001b[22m\u001b[39m  \u001b[32G   \u001b[38;5;246m┌──────────────────────────────────────────┐\u001b[39m\u001b[K\r\u001b[2C\u001b[1B  \u001b[38;5;153m\u001b[1mper line\u001b[22m\u001b[39m \u001b[15G   \u001b[19G  \u001b[22G       \u001b[30G     \u001b[38;5;246m│ \u001b[39mName:\u001b[43G[ release   \u001b[56G    \u001b[61G   ]\u001b[38;5;246m             │\r\u001b[1C\u001b[1B 2.\u001b[6G\u001b[39mRepeating\u001b[16Grows\u001b[21Gwith\u001b[26G+\u001b[28G/\u001b[30G−\u001b[35G\u001b[38;5;246m│ \u001b[39mSteps:\u001b[38;5;246m                                   │\r\u001b[1B\u001b[39m \u001b[38;5;246m 3.\u001b[39m One input,     \u001b[22G            \u001b[35G\u001b[38;5;220m├─── ✂ ─── 6 lines hidden ─────────────────┤\r\u001b[4C\u001b[1B\u001b[39mcomma-separated\u001b[35G\u001b[38;5;246m└──────────────────────────────────────────┘\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B  \u001b[35G\u001b[38;5;153mNotes:\u001b[42G\u001b[38;5;246m\u001b[3mpress n to add notes\r\u001b[1B\u001b[23m\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;246m────────────────────────────────────────────────────────────────────────────────────────────────────\r\u001b[2C\u001b[1B\u001b[39mChat about this\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;246mEnter to select ·\u001b[19G↑/↓ to n\u001b[28Gvigate · n to\u001b[42Gadd notes · Tab to switch questions · Esc to cancel\u001b[39m\u001b[28;1H"]
