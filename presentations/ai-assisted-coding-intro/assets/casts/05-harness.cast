[104.258548, "o", "\u001b[H\r\u001b[10B\u001b[K\r\u001b[1B\u001b[38;5;246m────────────────────────────────────────────────────────────────────────────────────────────────────\r\u001b[1B\u001b[39m←\u001b[4G☒\u001b[6GRows\u001b[12G☒\u001b[14GBlank\u001b[20Grows\u001b[26G☒\u001b[28GRefresh\u001b[36G\u001b[48;5;153m\u001b[38;5;16m ✔ Submit \u001b[49m\u001b[38;5;246m →\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;231m\u001b[1mReview your answers\r\u001b[2C\u001b[1B\u001b[22m\u001b[39m\u001b[K\r\u001b[1C\u001b[1B●\u001b[4GWith repeating rows: how many rows at start, and can the user delete down to zero?\u001b[K\r\u001b[3C\u001b[1B\u001b[38;5;114m→ Start with 1, minimum 1\r\u001b[1C\u001b[1B\u001b[39m● A\u001b[6Grow lef\u001b[14G blank\u001b[21Gwhen Cr\u001b[29Gate\u001b[33Gis\u001b[36Gpressed\u001b[44G—\u001b[46Gdropped\u001b[54Gor\u001b[57Gblocking?\r\u001b[3C\u001b[1B\u001b[38;5;114m→ Silently dropped\u001b[39m\u001b[K\r\u001b[1B ● After a successful create,\u001b[31Ghow\u001b[35Gdoes\u001b[40Gthe\u001b[44Gnew\u001b[48Grun\u001b[52Greach\u001b[58Gthe\u001b[62Glist?\r\u001b[3C\u001b[1B\u001b[38;5;114m→ Refetch GET /runs\u001b[39m\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;246mReady to sub\u001b[14Gi\u001b[16G your answers?\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;5;153m❯\u001b[3G\u001b[38;5;246m1. \u001b[38;5;153mSubmit answers\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;5;246m2. \u001b[39mCancel\r\u001b[1B\u001b[K\u001b[28;1H\u001b[26;1H"]
