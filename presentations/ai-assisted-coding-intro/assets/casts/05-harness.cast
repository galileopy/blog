agent to finish\u001b[44G\u001b[39m\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;5;174m·\u001b[3GSpinning… \r\u001b[1B\u001b[38;5;246m  ⎿  T\u001b[8Gp:\u001b[11GHit\u001b[15Gshift+tab to\u001b[28Gcycle\u001b[34Gbetween manual mode, auto-accept edit mode, and plan mode\r\u001b[3B❯ \u001b[39m\u001b[28;1H\u001b[23;3H\u001b[?25h"]
